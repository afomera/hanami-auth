# frozen_string_literal: true

require "base64"
require "openssl"

module <%= namespace %>
  module Authentication
    # Signed, expiring password reset tokens, with no database table.
    #
    # A token carries the <%= model %>'s id, an expiry time, and a fingerprint of their current password hash,
    # all signed with the app's session secret. Resetting the password changes the fingerprint, so a
    # token can be used only once.
    class PasswordResetTokens
      include Deps["settings", "repos.<%= model %>_repo"]

      EXPIRES_IN = 15 * 60 # 15 minutes

      def generate(<%= model %>, now: Time.now)
        payload = [<%= model %>.id, now.to_i + EXPIRES_IN].join(".")
        [payload, sign(payload, <%= model %>.password_hash)].join("--").then { Base64.urlsafe_encode64(_1, padding: false) }
      end

      # Returns the token's <%= model %>, or nil if the token is invalid, expired, or already used.
      def resolve(token, now: Time.now)
        payload, signature = Base64.urlsafe_decode64(token.to_s).split("--", 2)
        record_id, expires_at = payload.to_s.split(".", 2).map { Integer(_1, exception: false) }
        return unless record_id && expires_at && signature && expires_at > now.to_i

        record = <%= model %>_repo.get(record_id) or return
        record if OpenSSL.fixed_length_secure_compare(sign(payload, record.password_hash), signature)
      rescue ArgumentError
        nil
      end

      private

      def sign(payload, password_hash)
        OpenSSL::HMAC.hexdigest("SHA256", key, "#{payload}.#{password_hash}")
      end

      def key
        OpenSSL::HMAC.digest("SHA256", settings.session_secret, "password reset")
      end
    end
  end
end
