# frozen_string_literal: true

module <%= namespace %>
  module Operations
    # Sets a new password from a reset token, and signs the <%= model %> out everywhere.
    class ResetPassword < <%= namespace %>::Operation
      MINIMUM_LENGTH = 12

      include Deps[
        "repos.<%= model %>_repo",
        "repos.<%= session_repo %>",
        "authentication.password_reset_tokens"
      ]

      def call(token:, password:, password_confirmation:)
        <%= model %> = step resolve_token(token)
        step validate(password, password_confirmation)

        transaction do
          <%= model %>_repo.update_password(<%= model %>.id, password)
          # Whoever knew the old password shouldn't stay signed in.
          <%= session_repo %>.delete_all_for_<%= model %>(<%= model %>.id)
        end

        <%= model %>
      end

      private

      def resolve_token(token)
        <%= model %> = password_reset_tokens.resolve(token)
        <%= model %> ? Success(<%= model %>) : Failure(:invalid_token)
      end

      def validate(password, password_confirmation)
        if password.to_s.length < MINIMUM_LENGTH
          Failure[:invalid_password, "Password must be at least #{MINIMUM_LENGTH} characters."]
        elsif password != password_confirmation
          Failure[:invalid_password, "Passwords don't match."]
        else
          Success()
        end
      end
    end
  end
end
