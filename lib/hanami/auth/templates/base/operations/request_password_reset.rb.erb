# frozen_string_literal: true

module <%= namespace %>
  module Operations
    # Emails a password reset link, if the email address belongs to an account.
    class RequestPasswordReset < <%= namespace %>::Operation
      include Deps[
        "repos.<%= model %>_repo",
        "authentication.password_reset_tokens",
        "routes",
        "logger",
        password_reset_mailer: "mailers.password_reset"
      ]

      def call(email_address:)
        <%= model %> = step find_<%= model %>(email_address)

        # Build the link from the configured base URL, never a request's Host header, so a forged Host
        # can't point the emailed link at another site.
        reset_url = routes.url(:<%= route(:edit_password) %>, id: password_reset_tokens.generate(<%= model %>)).to_s
        password_reset_mailer.deliver(<%= model %>:, reset_url:)

        # Without SMTP configured, development mail is held in memory. Log the link so you can use it.
        logger.info("Password reset link for #{<%= model %>.email_address}: #{reset_url}") if Hanami.env?(:development)

        <%= model %>
      end

      private

      def find_<%= model %>(email_address)
        <%= model %> = <%= model %>_repo.find_by_email(email_address)
        <%= model %> ? Success(<%= model %>) : Failure(:unknown_email)
      end
    end
  end
end
