# frozen_string_literal: true

RSpec.describe <%= namespace %>::Operations::ResetPassword, :db do
  subject(:reset_password) { <%= container %>["operations.reset_password"] }

  let(:<%= model %>_repo) { <%= container %>["repos.<%= model %>_repo"] }
  let(:tokens) { <%= container %>["authentication.password_reset_tokens"] }
  let(:new_password) { "a brand new password" }
  let!(:<%= model %>) { <%= model %>_repo.create(email_address: "someone@example.com", password: "correct horse battery staple") }

  it "sets the new password and signs the <%= model %> out everywhere" do
    <%= container %>["repos.<%= session_repo %>"].create(<%= foreign_key %>: <%= model %>.id, token_digest: "digest")

    result = reset_password.call(token: tokens.generate(<%= model %>), password: new_password, password_confirmation: new_password)

    expect(result).to be_success
    expect(<%= container %>["operations.sign_in"].call(email_address: "someone@example.com", password: new_password)).to be_success
    expect(<%= container %>["relations.<%= sessions_table %>"].where(<%= foreign_key %>: <%= model %>.id).count).to eq 0
  end

  it "accepts a token only once" do
    token = tokens.generate(<%= model %>)
    reset_password.call(token:, password: new_password, password_confirmation: new_password)

    result = reset_password.call(token:, password: "another new password", password_confirmation: "another new password")

    expect(result.failure).to eq :invalid_token
  end

  it "rejects an expired token" do
    token = tokens.generate(<%= model %>, now: Time.now - (16 * 60))

    expect(reset_password.call(token:, password: new_password, password_confirmation: new_password).failure).to eq :invalid_token
  end

  it "rejects a short or mismatched password" do
    token = tokens.generate(<%= model %>)

    expect(reset_password.call(token:, password: "short", password_confirmation: "short").failure)
      .to eq [:invalid_password, "Password must be at least 12 characters."]
    expect(reset_password.call(token:, password: new_password, password_confirmation: "something else").failure)
      .to eq [:invalid_password, "Passwords don't match."]
  end
end
