# frozen_string_literal: true

require "test_helper"

class <%= test_class_prefix %>RequestPasswordResetTest < Hanami::Minitest::Test
  include TestSupport::DB
  include TestSupport::Mailers

  def setup
    super
    <%= container %>["repos.<%= model %>_repo"].create(email_address: "someone@example.com", password: "correct horse battery staple")
  end

  test "emails a reset link" do
    assert request_password_reset.call(email_address: "someone@example.com").success?

    assert_equal 1, deliveries.size
    assert_equal ["someone@example.com"], deliveries.last.message.to
    assert_match %r{/passwords/[\w-]+/edit}, deliveries.last.message.text_body
  end

  test "sends nothing for an unknown email address" do
    assert_equal :unknown_email, request_password_reset.call(email_address: "nobody@example.com").failure
    assert_empty deliveries
  end

  private

  def request_password_reset = <%= container %>["operations.request_password_reset"]

  def deliveries = <%= container %>["mailers.delivery_method"].deliveries
end
