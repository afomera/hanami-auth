# frozen_string_literal: true

require "test_helper"

class <%= test_class_prefix %>ResetPasswordTest < Hanami::Minitest::Test
  include TestSupport::DB

  NEW_PASSWORD = "a brand new password"

  def setup
    super
    @<%= model %> = <%= container %>["repos.<%= model %>_repo"].create(email_address: "someone@example.com", password: "correct horse battery staple")
  end

  test "sets the new password and signs the <%= model %> out everywhere" do
    <%= container %>["repos.<%= session_repo %>"].create(<%= foreign_key %>: @<%= model %>.id, token_digest: "digest")

    result = reset_password.call(token: tokens.generate(@<%= model %>), password: NEW_PASSWORD, password_confirmation: NEW_PASSWORD)

    assert result.success?
    assert <%= container %>["operations.sign_in"].call(email_address: "someone@example.com", password: NEW_PASSWORD).success?
    assert_equal 0, <%= container %>["relations.<%= sessions_table %>"].where(<%= foreign_key %>: @<%= model %>.id).count
  end

  test "accepts a token only once" do
    token = tokens.generate(@<%= model %>)
    reset_password.call(token:, password: NEW_PASSWORD, password_confirmation: NEW_PASSWORD)

    result = reset_password.call(token:, password: "another new password", password_confirmation: "another new password")

    assert_equal :invalid_token, result.failure
  end

  test "rejects an expired token" do
    token = tokens.generate(@<%= model %>, now: Time.now - (16 * 60))

    assert_equal :invalid_token, reset_password.call(token:, password: NEW_PASSWORD, password_confirmation: NEW_PASSWORD).failure
  end

  test "rejects a short or mismatched password" do
    token = tokens.generate(@<%= model %>)

    assert_equal [:invalid_password, "Password must be at least 12 characters."],
      reset_password.call(token:, password: "short", password_confirmation: "short").failure
    assert_equal [:invalid_password, "Passwords don't match."],
      reset_password.call(token:, password: NEW_PASSWORD, password_confirmation: "something else").failure
  end

  private

  def reset_password = <%= container %>["operations.reset_password"]

  def tokens = <%= container %>["authentication.password_reset_tokens"]
end
